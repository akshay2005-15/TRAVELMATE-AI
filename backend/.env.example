# TRAVELMATE AI - Backend Environment Configuration Example
ENVIRONMENT=development
PORT=8000
SECRET_KEY=replace_with_a_secure_random_64_character_hex_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration:
# PostgreSQL: postgresql://username:password@localhost:5432/travelmate_db
# SQLite fallback: sqlite:///./travelmate.db
DATABASE_URL=sqlite:///./travelmate.db

# LLM & AI Orchestration
GEMINI_API_KEY=your_gemini_api_key_here

# Flight Provider Configuration
FLIGHT_PROVIDER=duffel
DUFFEL_API_TOKEN=duffel_test_your_token_here

# Allowed CORS Origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

